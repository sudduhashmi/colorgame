/* Chat UI */
.chat-container {
    width: 100%;
    max-width: 400px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: white;
    /* border-radius: 15px; */
    box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

.chat-header {
    background: #000098;
    color: white;
    text-align: center;
    padding: 5px;
    /* font-size: 18px;
    font-weight: bold; */
}

.chat-box {
    flex: 1;
    padding: 15px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.chat-message {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 80%;
}

.bot-message {
    display: flex;
    align-items: center;
    gap: 10px;
}

.bot-message img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

.user-message {
    background: black;
    color: white;
    padding: 12px 15px;
    border-radius: 20px;
    align-self: flex-end;
}

.chat-input-area {
    display: flex;
    padding: 10px;
    background: rgb(0 0 152);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

.chat-input-area input {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 25px;
    background: #eee;
    font-size: 16px;
}

.chat-input-area button {
    /* padding: 12px; */
    height: 44px;
    width: 44px;
    border: none;
    border-radius: 70px;
    background: #ffffff;
    color: #000098;
    cursor: pointer;
    font-size: 16px;
    margin: 0px 0px 0px 8px;
}

.chat-input-area button:active {
    transform: scale(0.95);
    box-shadow: 0px 2px 15px rgba(0, 0, 0, 0.3);
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.intro-message {
    color: #000098;
    font-size: 13px;
    padding: 10px 15px;
    text-align: center;
    max-width: 100%;
    align-self: center;
    opacity: 0.8;
}
</style>
</head>


